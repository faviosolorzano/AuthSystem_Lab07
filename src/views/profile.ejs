<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0">

    <title>Mi cuenta</title>

    <link
        href="https://fonts.googleapis.com/icon?family=Material+Icons"
        rel="stylesheet">

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css">

    <link
        rel="stylesheet"
        href="/css/style.css">

</head>

<body>

<nav class="nav-main">

    <div class="nav-wrapper container">

        <a href="/dashboard"
           class="brand-logo">
            Auth<span>System</span>
        </a>

        <a href="#"
           data-target="mobile-nav"
           class="sidenav-trigger">
            <i class="material-icons">menu</i>
        </a>

        <ul class="right hide-on-med-and-down">

            <li>
                <a href="/dashboard">
                    Dashboard
                </a>
            </li>

            <li class="active">
                <a href="/profile">
                    Mi cuenta
                </a>
            </li>

            <li id="adminNav">
                <a href="/admin">
                    Administración
                </a>
            </li>

            <li>
                <a href="#"
                   onclick="logout()">
                    Cerrar sesión
                </a>
            </li>

        </ul>

    </div>

</nav>

<ul class="sidenav" id="mobile-nav">

    <li>
        <a href="/dashboard">
            Dashboard
        </a>
    </li>

    <li>
        <a href="/profile">
            Mi cuenta
        </a>
    </li>

    <li id="adminNavMobile">
        <a href="/admin">
            Administración
        </a>
    </li>

    <li>
        <a href="#"
           onclick="logout()">
            Cerrar sesión
        </a>
    </li>

</ul>

<main class="container dashboard-container">

    <div class="card profile-card">

        <div class="card-content">

            <span class="card-title">
                Mi cuenta
            </span>

            <p class="grey-text">
                Consulta y actualiza tus datos.
            </p>

            <br>

            <form id="profileForm">

                <div class="row">

                    <div class="input-field col s12 m6">

                        <input
                            id="name"
                            type="text"
                            required>

                        <label
                            for="name"
                            class="active">
                            Nombre
                        </label>

                    </div>

                    <div class="input-field col s12 m6">

                        <input
                            id="lastName"
                            type="text"
                            required>

                        <label
                            for="lastName"
                            class="active">
                            Apellido
                        </label>

                    </div>

                    <div class="input-field col s12 m6">

                        <input
                            id="email"
                            type="email"
                            disabled>

                        <label
                            for="email"
                            class="active">
                            Correo
                        </label>

                    </div>

                    <div class="input-field col s12 m6">

                        <input
                            id="phoneNumber"
                            type="text"
                            required>

                        <label
                            for="phoneNumber"
                            class="active">
                            Teléfono
                        </label>

                    </div>

                    <div class="input-field col s12 m6">

                        <input
                            id="birthdate"
                            type="date"
                            required>

                        <label
                            for="birthdate"
                            class="active">
                            Fecha de nacimiento
                        </label>

                    </div>

                    <div class="input-field col s12 m6">

                        <input
                            id="age"
                            type="number"
                            disabled>

                        <label
                            for="age"
                            class="active">
                            Edad
                        </label>

                    </div>

                    <div class="input-field col s12">

                        <input
                            id="url_profile"
                            type="url">

                        <label
                            for="url_profile"
                            class="active">
                            URL de perfil
                        </label>

                    </div>

                    <div class="input-field col s12">

                        <input
                            id="adress"
                            type="text">

                        <label
                            for="adress"
                            class="active">
                            Dirección
                        </label>

                    </div>

                </div>

                <div id="roles"></div>

                <br>

                <div
                    id="message"
                    class="center-align">
                </div>

                <button
                    type="submit"
                    class="btn btn-main waves-effect">

                    Guardar cambios

                    <i class="material-icons right">
                        save
                    </i>

                </button>

            </form>

        </div>

    </div>

</main>

<footer class="page-footer">

    <div class="container center-align">

        <p>
            Sistema de autenticación con JWT
        </p>

    </div>

</footer>

<script
    src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js">
</script>

<script src="/js/auth.js"></script>
<script src="/js/profile.js"></script>

</body>
</html>