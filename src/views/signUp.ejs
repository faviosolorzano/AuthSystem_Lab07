<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0">

    <title>Crear cuenta</title>

    <link
        href="https://fonts.googleapis.com/icon?family=Material+Icons"
        rel="stylesheet">

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css">

    <link
        rel="stylesheet"
        href="/css/style.css">

</head>

<body>

<div class="auth-page">

    <div class="card auth-card">

        <div class="auth-header">

            <h4>Crear cuenta</h4>

            <p>
                Regístrate en nuestro sistema
            </p>

        </div>

        <div class="auth-body">

            <form id="signUpForm">

                <div class="row">

                    <div class="input-field col s12 m6">
                        <input
                            id="name"
                            type="text"
                            required>

                        <label for="name">
                            Nombre
                        </label>
                    </div>

                    <div class="input-field col s12 m6">
                        <input
                            id="lastName"
                            type="text"
                            required>

                        <label for="lastName">
                            Apellido
                        </label>
                    </div>

                    <div class="input-field col s12">
                        <input
                            id="phoneNumber"
                            type="text"
                            required>

                        <label for="phoneNumber">
                            Teléfono
                        </label>
                    </div>

                    <div class="input-field col s12">
                        <input
                            id="birthdate"
                            type="date"
                            required>

                        <label class="active"
                               for="birthdate">
                            Fecha de nacimiento
                        </label>
                    </div>

                    <div class="input-field col s12">
                        <input
                            id="email"
                            type="email"
                            required>

                        <label for="email">
                            Correo electrónico
                        </label>
                    </div>

                    <div class="input-field col s12">
                        <input
                            id="password"
                            type="password"
                            minlength="8"
                            required>

                        <label for="password">
                            Contraseña
                        </label>

                        <span class="helper-text">
                            Mínimo 8 caracteres,
                            1 mayúscula,
                            1 número y
                            1 carácter especial
                            (# $ % & * @)
                        </span>
                    </div>

                </div>

                <div
                    id="message"
                    class="red-text center-align">
                </div>

                <br>

                <button
                    class="btn btn-main waves-effect waves-light"
                    type="submit">

                    Registrarme

                    <i class="material-icons right">
                        person_add
                    </i>

                </button>

            </form>

            <div class="center-align"
                 style="margin-top: 25px">

                <span>
                    ¿Ya tienes una cuenta?
                </span>

                <a href="/signIn">
                    Iniciar sesión
                </a>

            </div>

        </div>

    </div>

</div>

<script
    src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js">
</script>

<script src="/js/auth.js"></script>

</body>
</html>